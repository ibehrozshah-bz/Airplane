<body>
<div class="row g-2 mb-3">
    <div class="col-6">
        <label class="form-label small fw-semibold">Lunch</label>
        <select class="form-select-aero">
            <option value="0">No Meal ($0)</option>
            <option value="15">Standard Meal ($15)</option>
            <option value="20">Vegetarian Meal ($20)</option>
            <option value="25">Premium Meal ($25)</option>
            <option value="30">Kids Meal ($30)</option>
        </select>
    </div>
</div>
